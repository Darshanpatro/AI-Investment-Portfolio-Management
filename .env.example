# ==========================================================
# Environment variables for AI-Based Investment Portfolio
# Management and Risk Analysis System
# ==========================================================

# Flask
SECRET_KEY=change-this-to-a-random-secret-string
FLASK_ENV=development
FLASK_DEBUG=True

# Database (SQLite file path, relative to project root)
DATABASE_URL=sqlite:///database/portfolio.db

# LLM API (used by the AI Assistant / RAG explanation generation)
# If this is left empty, the system will automatically fall back to
# rule-based, template-generated answers instead of pretending to
# call an LLM. This is a documented, honest fallback -- not fake data.
LLM_API_KEY=
LLM_API_URL=https://api.anthropic.com/v1/messages
LLM_MODEL=claude-3-5-haiku-20241022

# Market Data (optional external API for live prices).
# If left empty, the system uses the bundled historical/sample CSV
# data in data/market_data.csv and clearly labels it as such.
MARKET_DATA_API_KEY=
MARKET_DATA_API_URL=

# Risk thresholds (can be tuned without touching code)
CONCENTRATION_THRESHOLD_PERCENT=40
DRAWDOWN_ALERT_THRESHOLD_PERCENT=-10
ANOMALY_CONTAMINATION=0.05
